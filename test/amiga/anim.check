#!/bin/sh
# checks for anim.script: the clock started, the screen changed in the
# animated rows only
d=$(dirname "$1"); fail=0
cat "$d/anim.driver"
grep -q '^anim' "$d/anim.log" || { echo "the clock did not start"; fail=1; }
grep -q '^ok$' "$d/anim.driver" || fail=1
grep -q '^exit rc=0' "$1" || { echo "velox exit code: $(grep exit "$1")"; fail=1; }
exit $fail
