# CSS: selectors, cascade, media queries, properties
layout test/unit/layout/css.html 400
layout test/unit/layout/css.html 250
layout test/unit/layout/example.html 600
# :not() :is() :where() and structural pseudo-classes
layout test/unit/layout/selectors.html 600
# media queries level 4 ranges, @media without a blank
layout test/unit/layout/mq4.html 600
# <style media="print"> is not for the screen
layout test/unit/layout/mediaattr.html 400
# the ancestor filter (css.s) changes nothing: big.html with its sheet
cssfilter test/www/big.html test/www/css/big.css 400
# custom properties of the root (var(), fallbacks, nested, defined
# later; not another variation's or a dark scheme's); rgb(), rgba(),
# hsl(), hsla() with calc(); alpha mixed with white
layout test/unit/layout/vars.html 400
