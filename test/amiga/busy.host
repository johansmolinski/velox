#!/usr/bin/env python3
"""Host side of busy.script: the window responds at once while images
load (without fetching them again); the page left is blank at once
when another loads, with a progress bar (none when nothing loads); Esc
stops a page load and the page left comes back."""
import os
import sys
import subprocess
import time
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "busy.log")
out = open(os.path.join(r, "busy.driver"), "w")
U = "http://127.0.0.1:8080/"


def step(msg):
    out.write(msg + "\n")
    out.flush()


def count(lines, prefix):
    return len([l for l in lines if l.startswith(prefix)])


def look(name):
    """Screenshot name: (colours in the page area, pixels of the
    progress bar's fill colour at the right of the status line).
    (PIL is in the system's Python, not in tools/venv.)"""
    p = os.path.join(r, name)
    Amiga().shot(p)
    o = subprocess.run(["/usr/bin/python3", "-I", "-c", """
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert("RGB")
page = len(set(im.getpixel((x, y)) for x in range(140, 800, 2)
               for y in range(165, 525, 2)))
bar = sum(1 for x in range(740, 832) for y in range(536, 560)
          if im.getpixel((x, y)) == (102, 136, 187))
print(page, bar)
""", p], capture_output=True, text=True, check=True).stdout.split()
    return int(o[0]), int(o[1])


def scroll_now(a, key, lines):
    """Press key; the page must scroll within a second and a half."""
    n = count(lines, "scroll ")
    t0 = time.time()
    a.key(key)
    lines = wait_log(log, "scroll ", n + 1, timeout=10)
    dt = time.time() - t0
    if dt > 1.5:
        raise AssertionError("%s scrolled after %.1f s" % (key, dt))
    return lines


try:
    a = Amiga()
    lines = wait_log(log, "page " + U + "busy.html")
    time.sleep(1)
    for key in ("Down", "Down", "shift+Down"):
        lines = scroll_now(a, key, lines)
    if count(lines, "images "):
        raise AssertionError("the images were loaded already")
    step("scrolling works at once while images load")
    lines = wait_log(log, "images ", timeout=90)
    hits = int(urllib.request.urlopen(U + "slowcount/b").read())
    if hits != 3:
        raise AssertionError("3 images fetched %d times" % hits)
    step("the images were not fetched again")

    time.sleep(1)
    page, bar = look("busy-idle.png")
    if bar:
        raise AssertionError("a progress bar while nothing loads")
    step("nothing loads: no progress bar")
    a.key("ctrl+l"); a.key("amiga+x")
    a.type("127.0.0.1:8080/slowpage")
    a.key("Return")
    wait_log(log, "go " + U + "slowpage")
    time.sleep(1)
    page, bar = look("busy-blank.png")
    if page != 1:
        raise AssertionError("not blank while another page loads (%d colours)" % page)
    if not bar:
        raise AssertionError("no progress bar while a page loads")
    step("another page loads: blank at once, with a progress bar")
    t0 = time.time()
    a.key("Escape")
    wait_log(log, "stopped " + U + "slowpage", timeout=10)
    dt = time.time() - t0
    if dt > 1.5:
        raise AssertionError("Esc stopped the load after %.1f s" % dt)
    time.sleep(1)
    page, bar = look("busy-back.png")
    if page < 10:
        raise AssertionError("the page left did not come back")
    if bar:
        raise AssertionError("the progress bar stayed")
    lines = scroll_now(a, "Down", wait_log(log, "stopped "))
    if count(lines, "page " + U + "slowpage"):
        raise AssertionError("the slow page was shown")
    step("Esc stops a page load, the page left comes back")
    a.key("ctrl+q")
    step("ok")
except Exception as e:
    step("FAIL " + repr(e))
    try:
        Amiga().key("ctrl+q")
    except Exception:
        pass
