# HTML parser: DOM dumps
html test/unit/html/basic.html => 
#document
  <html>
    <head>
      <meta charset="utf-8">
      <title>
        "Basic & simple"
    <body>
      " "
      <h1 class="title">
        "Hello, "
        <em>
          "world"
        "!"
      " "
      <p>
        "First paragraph with blanks. "
      <p>
        "Second <b> \xa9 2026 ... A\xa0B "

html test/unit/html/implied.html => 
#document
  <body>
    <ul>
      <li>
        "one"
      <li>
        "two"
        <ul>
          <li>
            "nested"
      <li>
        "three"
    " "
    <dl>
      <dt>
        "term"
      <dd>
        "def"
      <dt>
        "term2"
    " "
    <table>
      <tr>
        <td>
          "a"
        <td>
          "b"
      <tr>
        <td>
          "c"
    " "
    <p>
      "para"
    <div>
      "block"
    " "
    <a href="/x">
      "one"
    <a href="/y">
      "two"
    " "
    <select>
      <option>
        "A"
      <option selected="">
        "B"
    " "
    <h2>
      "head"
    <h3>
      "sub"
    " "

# no <head>, no <body>: the body implied when the content begins
html test/unit/html/nobody.html => 
#document
  <html lang="en" id="main">
    <meta charset="utf-8">
    <title>
      "No body"
    <link rel="stylesheet" href="x.css">
    <body>
      <main>
        " "
        <nav>
          "menu"
        " "
        <article>
          "text"
        " "
      " "

html test/unit/html/raw.html => 
#document
  <script>
    "if (a < b && c > d) { x = "</p>"; }"
  <style>
    "p > a { color: red }"
  <body>
    <pre>
      "  line 1\n    line 2"
    " "
    <textarea name="t">
      " keep  & this"
    " "
    <img src="a.png" alt="x & y" width="10" data-x="1&copy=2" checked="">
    " "
    <p title="a&b">
      "5 < 6 and 7 > 3 &unknown; \xacit \xa92026"
    " "
    <br>
    <br>
    <?>
    "bar "

# character sets (fixtures generated by mkhttp.py)
html build/html/utf8.html => 
#document
  <body>
    <p>
      "Gr\xfc\xdfe - "quotes" ... EUR l"

html build/html/latin1.html => 
#document
  <body>
    <p>
      "caf\xe9 "hi""

html build/html/metalatin1.html => 
#document
  <meta charset="iso-8859-1">
  <body>
    <p>
      "\xc3\xa9"

html build/html/nul.html => 
#document
  <body>
    <p>
      "a b"

