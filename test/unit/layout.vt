# layout with fixed test metrics (8 px per character)
layout test/unit/layout/text.html 200
layout test/unit/layout/table.html 300
# colspan widens only as needed; minimums too wide: squeezed, nowrap wraps
layout test/unit/layout/squeeze.html 200
# a frameset laid out as a document (not frames: those are views of
# their own, gui.s): its frames one after the other, each a link to its
# document when that cannot be fetched (here); no <noframes>; iframes: links
layout test/unit/layout/frames.html 400
# images in tables are measured by their size or, unknown, their alt text
layout test/unit/layout/imgalt.html 300
# align="left" and friends (a clobbered register once made it "right")
layout test/unit/layout/align.html 300
# the first line of an indented block starts at its edge
layout test/unit/layout/indent.html 400
# floated images (align=left/right, CSS float), <br clear>, floats in cells
layout test/unit/layout/floats.html 300
# rowspan: later rows skip the covered columns; a tall cell stretches its last row
layout test/unit/layout/rowspan.html 300
# <body link=...>: the links in it get that colour
layout test/unit/layout/linkcolor.html 300
# a list with an icon floated in each item: each at the edge, though our
# smaller text makes the icons reach into the next item; tall floats
# still go beside the one above
layout test/unit/layout/iconlist.html 300
# a link styled as a button (Safir's "Ny Blogg"): a background behind
# it, its paddings around it, its box-shadow an outline; a highlighted
# span gets its background too
layout test/unit/layout/linkbutton.html 300
# CSS grid (grid.s): fixed and fr columns with gaps, spans (to line
# -1, span 2); areas by name (the items in another order); repeat
# (auto-fill, minmax()); auto columns from their content, align-items:
# center; items placed by line before the others
layout test/unit/layout/grid.html 400
# <blink> and text-decoration: blink (soft style 16), <marquee>: a run
# of its own across its block, one line (marq), width= kept
layout test/unit/layout/anim.html 400
# ::before and ::after: strings (escapes decoded; icon fonts' private use
# code points left out), attr(), quotes, several tokens; their own style
# (colour); display: none, empty content: no box
layout test/unit/layout/pseudo.html 400
