#!/usr/bin/env python3
"""Host side of imgcss.script: wait for the images, screenshot, quit."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from xdrive import Amiga, wait_log  # noqa: E402

r = sys.argv[1]
log = os.path.join(r, "imgcss.log")
out = open(os.path.join(r, "imgcss.driver"), "w")
try:
    a = Amiga()
    lines = wait_log(log, "images ", timeout=120)
    time.sleep(1)
    a.shot(os.path.join(r, "imgcss.png"))
    out.write("%s\n" % " ".join(l for l in lines if l.startswith("imgsize")))
    out.write("ok\n")
except Exception as e:
    out.write("FAIL %r\n" % e)
Amiga().key("ctrl+q")
