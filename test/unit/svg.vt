# SVG images (svg.s): drawn at their own size and at others; the pixels
# are compared with rsvg-convert's (test/unit/cmpsvg.py, the references
# made by test/unit/mksvgref.sh)
decode test/unit/svg/shapes.svg build/svg/shapes.0.argb
decode test/unit/svg/shapes.svg build/svg/shapes.240.argb 240
decode test/unit/svg/paths.svg build/svg/paths.0.argb
decode test/unit/svg/evenodd.svg build/svg/evenodd.0.argb
decode test/unit/svg/transform.svg build/svg/transform.0.argb
decode test/unit/svg/styled.svg build/svg/styled.0.argb
decode test/unit/svg/styled.svg build/svg/styled.16.argb 16
decode test/unit/svg/icon.svg build/svg/icon.32.argb 32
decode test/unit/svg/icon.svg build/svg/icon.200.argb 200
decode test/unit/svg/gradient.svg build/svg/gradient.0.argb
decode test/unit/svg/use.svg build/svg/use.240.argb 240
